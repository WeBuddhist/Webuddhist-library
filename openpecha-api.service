[Unit]
Description=OpenPecha API (FastAPI)
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/openpecha-backend
Environment="PATH=/opt/openpecha-backend/.venv/bin"
EnvironmentFile=/opt/openpecha-backend/.env
ExecStart=/opt/openpecha-backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 4
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
